# PHPStan al nivel máximo sobre todo el PHP del repo, para PHP 8.1 a 8.5 (composer analyse).
# Un override local va en phpstan.neon (ignorado por git).
parameters:
    level: max
    phpVersion:
        min: 80100
        max: 80599
    paths:
        - src
        - tests
        - examples
        - scripts
    excludePaths:
        analyse:
            # Los nombres de la 1.1.0, alias deprecados (ver src/Internal/Deprecation.php). Su
            # declaración del if (\false) se escanea, como en el proyecto de quien usa el SDK,
            # pero no se analiza: extiende una clase final, un error que no se puede ignorar.
            - src/Checkout.php
            - src/Checkout/*
            - src/Service/CheckoutOrderService.php
            - src/Service/CheckoutService.php
        analyseAndScan:
            # Los lee tests/Types/TypesTest.php (TypeInferenceTestCase), no el análisis común.
            - tests/Types/data/*
            # Usan Laravel y Symfony, que no están instalados (como los webhooks de Python fuera
            # de mypy). Siguen pasando php -l en ReadmeTest.
            - examples/webhook-laravel.php (?)
            - examples/webhook-symfony.php (?)
    tmpDir: build/phpstan
    # Una librería no puede confiar en sus phpdoc: quien la usa puede pasar cualquier cosa.
    treatPhpDocTypesAsCertain: false
    checkUninitializedProperties: true
    # setUp() es el constructor de un test: ahí Support\TestCase arma $api.
    additionalConstructors:
        - PHPUnit\Framework\TestCase::setUp
